# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file (it is gitignored).

# ─── Meta Graph API ────────────────────────────────────────────────────────
# Long-lived Page access token — used for organic Facebook/Instagram data
FOOTLAND_TOKEN=

# User access token for the Marketing API — used by the Boost tab only
FOOTLAND_ADS_TOKEN=

# ─── Supabase (permanent metric cache + auth) ─────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
# Direct Postgres connection string, used only by db_setup.py
SUPABASE_DB_URL=

# ─── Groq (AI Assistant chatbot) ──────────────────────────────────────────
GROQ_API_KEY=

# ─── Google Analytics (GA4) ────────────────────────────────────────────────
# Not read from .env directly — GA4 auth uses ga4_token.json (generated by
# `python ga4_auth.py`, requires oauth_client.json) or, on Streamlit Cloud,
# the [ga4].token_json entry in .streamlit/secrets.toml.
